  "fig_sigma_r_precision": {
    "caption": "Direct fractional sigma_R/R for the four photometric mock tiers, plus a DESI DR1 density/volume forecast and the mock-footprint cosmic-variance reference. Mock points use effective redshift; DR1 uses bin centres. Effective volumes sum the attained cap densities and physical cap volumes, with the same frozen tracer-specific P0 in both mock and DR1 calculations. No common-area rescaling is applied. The original factor of 100 expressed percentages; every plotted value is now a dimensionless fraction. R is the combined distance-scale precision calibrated from DESI Table 7. The 0.001 tier is a constructed quarter-density proxy. This effective-volume diagnostic omits anisotropic photo-z information loss and reconstruction response; it is not fitted posterior precision.",
    "axes": [
      {
        "xlim": [
          0.1,
          1.0
        ],
        "ylim": [
          0.0,
          0.06940128174572947
        ],
        "xlabel": "Redshift z",
        "ylabel": "$\\sigma_R/R$"
      }
    ],
    "pdf": "fig_sigma_r_precision.pdf",
    "png": "fig_sigma_r_precision.png"
  }
